{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "node",
  "routes": [
      {
        "src": "/",
        "headers": { "cache-control": "s-maxage=1000" },
        "dest": "/index.html"
      },
      {
        "src": "/api", "dest": "/server.js"
      }
  ],
  "functions": {
    "server.js": {
      "includeFiles": "**"
    }
  }
}
